{
  "name": "eteelo-portail-parent",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "start:staging": "API_TARGET=https://api-staging.eteeloconnect.com ng serve --configuration staging-backend",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "api:spec": "node scripts/fetch-openapi.mjs",
    "api:types": "npx -y openapi-typescript@7.13.0 openapi/api-docs.json -o src/app/core/api/api-types.ts"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "@sentry/angular": "^11.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
